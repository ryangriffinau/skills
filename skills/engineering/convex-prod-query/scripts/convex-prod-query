#!/usr/bin/env bun
/**
 * convex-prod-query — run a named Convex QUERY against production (or another
 * deployment) in a way that is read-only by construction.
 *
 * Why this exists: `bunx convex run <fn> --prod` cannot be told apart from a
 * mutation on the command line, so the dcg guard confirms every prod-targeted
 * run. This tool only ever POSTs to the deployment's `/api/query` endpoint.
 * The Convex server refuses to execute anything but a query there
 * ("Trying to execute X as Query, but it is defined as Mutation"), and the
 * endpoint has no code-push path at all. It never spawns `convex run`,
 * `convex deploy`, or `convex dev`.
 *
 * Installed by the `convex-prod-query` skill (ryangriffinau/skills). The
 * `~/.local/bin/convex-prod-query` shim execs this file.
 *
 * Usage:
 *   convex-prod-query <module:function> [jsonArgs]
 *   convex-prod-query --list [substring]
 *   convex-prod-query --dev <module:function> [jsonArgs]   # same, against dev
 *
 * Credentials (first match wins), loaded from the enclosing repo's root .env:
 *   --dev  -> CONVEX_DEPLOY_KEY (dev key)
 *   prod   -> CONVEX_PROD_READ_KEY (scoped read-only prod token; preferred)
 *          -> CONVEX_PRODUCTION_DEPLOY_KEY (full deploy key; works, but warns)
 *
 * Exit codes: 0 success, 1 function error, 2 usage/config error.
 */
import { existsSync, readFileSync, unlinkSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, resolve } from "node:path";

type ParsedArgs = {
	args: Record<string, unknown>;
	dev: boolean;
	envFile: string | undefined;
	functionPath: string | undefined;
	list: string | undefined;
	url: string | undefined;
};

type QueryResponse =
	| { status: "success"; value: unknown }
	| { errorData?: unknown; errorMessage: string; status: "error" };

type FunctionSpecEntry = {
	functionType: string;
	identifier?: string;
	visibility?: { kind: string };
};

const readKeyVar = "CONVEX_PROD_READ_KEY";
const fullKeyVar = "CONVEX_PRODUCTION_DEPLOY_KEY";
const devKeyVar = "CONVEX_DEPLOY_KEY";
const version = "0.1.0";

function usage(): never {
	process.stderr.write(
		[
			`convex-prod-query ${version} — read-only Convex query runner`,
			"",
			"usage: convex-prod-query <module:function> [jsonArgs]",
			"       convex-prod-query --list [substring]",
			"       convex-prod-query --dev <module:function> [jsonArgs]",
			"       convex-prod-query --url https://<name>.convex.cloud <module:function> [jsonArgs]",
			"       convex-prod-query --env-file <path> ...   # dotenv to load (default: enclosing repo's .env)",
			"",
			"Runs QUERIES only, via POST /api/query. Mutations and actions are refused by the server.",
			`Prod credential: ${readKeyVar} (scoped read-only token) or ${fullKeyVar} (warns).`,
			"",
		].join("\n"),
	);
	process.exit(2);
}

function fail(message: string, code = 2): never {
	process.stderr.write(`convex-prod-query: ${message}\n`);
	process.exit(code);
}

function parseArgs(argv: string[]): ParsedArgs {
	let dev = false;
	let envFile: string | undefined;
	let list: string | undefined;
	let url: string | undefined;
	const positional: string[] = [];

	for (let index = 0; index < argv.length; index += 1) {
		const arg = argv[index] as string;
		if (arg === "--") {
			continue;
		}
		if (arg === "-h" || arg === "--help") {
			usage();
		}
		if (arg === "--version") {
			process.stdout.write(`${version}\n`);
			process.exit(0);
		}
		if (arg === "--dev") {
			dev = true;
		} else if (arg === "--list") {
			const next = argv[index + 1];
			if (next !== undefined && !next.startsWith("--")) {
				list = next;
				index += 1;
			} else {
				list = "";
			}
		} else if (arg === "--url") {
			const value = argv[index + 1];
			if (value === undefined) {
				fail("--url requires a value");
			}
			url = value;
			index += 1;
		} else if (arg === "--env-file") {
			const value = argv[index + 1];
			if (value === undefined) {
				fail("--env-file requires a path");
			}
			envFile = resolve(process.cwd(), value);
			index += 1;
		} else if (arg.startsWith("--")) {
			fail(
				`unknown option ${arg} (this tool deliberately has no --push, --prod, or write options)`,
			);
		} else {
			positional.push(arg);
		}
	}

	if (list === undefined && positional.length === 0) {
		usage();
	}
	if (positional.length > 2) {
		fail("expected <module:function> [jsonArgs]");
	}

	let args: Record<string, unknown> = {};
	if (positional[1] !== undefined) {
		let parsed: unknown;
		try {
			parsed = JSON.parse(positional[1]);
		} catch (error) {
			fail(`jsonArgs is not valid JSON: ${(error as Error).message}`);
		}
		if (
			parsed === null ||
			typeof parsed !== "object" ||
			Array.isArray(parsed)
		) {
			fail("jsonArgs must be a JSON object");
		}
		args = parsed as Record<string, unknown>;
	}

	return { args, dev, envFile, functionPath: positional[0], list, url };
}

/**
 * The repo root is the nearest ancestor of cwd (inclusive) that has a root
 * `.env` next to a `package.json`, or a `packages/backend` workspace. Falls back
 * to cwd so `--env-file` / exported variables still work outside a repo.
 */
function findRepoRoot(start: string): string {
	let dir = start;
	for (;;) {
		const hasEnv = existsSync(resolve(dir, ".env"));
		const hasPackage = existsSync(resolve(dir, "package.json"));
		const hasBackend = existsSync(resolve(dir, "packages/backend"));
		if ((hasEnv && hasPackage) || hasBackend) {
			return dir;
		}
		const parent = dirname(dir);
		if (parent === dir) {
			return start;
		}
		dir = parent;
	}
}

/** Minimal dotenv loader: never overrides values already in the environment. */
function loadEnv(path: string, explicit: boolean): void {
	if (!existsSync(path)) {
		if (explicit) {
			fail(`--env-file not found: ${path}`);
		}
		return;
	}
	const text = readFileSync(path, "utf8");
	for (const rawLine of text.split(/\r?\n/)) {
		const line = rawLine.trim();
		if (line.length === 0 || line.startsWith("#")) {
			continue;
		}
		const match = /^(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=\s*(.*)$/.exec(
			line,
		);
		if (match === null) {
			continue;
		}
		const name = match[1] as string;
		let value = (match[2] as string).trim();
		const quote = value[0];
		if (
			(quote === '"' || quote === "'") &&
			value.length >= 2 &&
			value.endsWith(quote)
		) {
			value = value.slice(1, -1);
		} else {
			const hash = value.indexOf(" #");
			if (hash !== -1) {
				value = value.slice(0, hash).trim();
			}
		}
		if (process.env[name] === undefined) {
			process.env[name] = value;
		}
	}
}

function envValue(name: string): string | undefined {
	const value = process.env[name]?.trim();
	return value === undefined || value.length === 0 ? undefined : value;
}

function resolveCredential(dev: boolean): { key: string; label: string } {
	if (dev) {
		const key = envValue(devKeyVar);
		if (key === undefined) {
			fail(`--dev needs ${devKeyVar} in the environment or the repo's root .env`);
		}
		return { key, label: devKeyVar };
	}
	const readKey = envValue(readKeyVar);
	if (readKey !== undefined) {
		return { key: readKey, label: readKeyVar };
	}
	const fullKey = envValue(fullKeyVar);
	if (fullKey !== undefined) {
		process.stderr.write(
			`convex-prod-query: WARNING using ${fullKeyVar} (a full deploy key). ` +
				`Mint a scoped read-only token and set ${readKeyVar} instead. ` +
				"Reads are still query-only: /api/query cannot write or deploy.\n",
		);
		return { key: fullKey, label: fullKeyVar };
	}
	fail(
		`no credential: set ${readKeyVar} (preferred) or ${fullKeyVar} in the environment or the repo's root .env`,
	);
}

/** Convex keys look like `prod:content-bullfrog-682|<secret>`; the prefix names the deployment. */
function deploymentFromKey(
	key: string,
): { name: string; type: string } | undefined {
	const prefix = key.split("|")[0];
	const match = /^([a-z]+):([a-z0-9-]+)$/i.exec(prefix ?? "");
	if (match === null) {
		return undefined;
	}
	return { name: match[2] as string, type: match[1] as string };
}

function resolveUrl(
	key: string,
	override: string | undefined,
): { url: string; label: string } {
	if (override !== undefined) {
		return { label: override, url: override.replace(/\/+$/, "") };
	}
	const deployment = deploymentFromKey(key);
	if (deployment === undefined) {
		fail(
			"could not derive the deployment name from the key prefix; pass --url https://<name>.convex.cloud",
		);
	}
	return {
		label: `${deployment.type}:${deployment.name}`,
		url: `https://${deployment.name}.convex.cloud`,
	};
}

async function runQuery(
	url: string,
	key: string,
	functionPath: string,
	args: Record<string, unknown>,
): Promise<QueryResponse> {
	let response: Response;
	try {
		response = await fetch(`${url}/api/query`, {
			body: JSON.stringify({ args, format: "json", path: functionPath }),
			headers: {
				Authorization: `Convex ${key}`,
				"Content-Type": "application/json",
			},
			method: "POST",
		});
	} catch (error) {
		fail(`request to ${url}/api/query failed: ${(error as Error).message}`, 1);
	}
	const text = await response.text();
	let parsed: unknown;
	try {
		parsed = JSON.parse(text);
	} catch {
		fail(
			`unexpected non-JSON response from ${url}/api/query (HTTP ${response.status}): ${text.slice(0, 400)}`,
			1,
		);
	}
	if (parsed === null || typeof parsed !== "object" || !("status" in parsed)) {
		fail(
			`unexpected response shape from ${url}/api/query (HTTP ${response.status}): ${text.slice(0, 400)}`,
			1,
		);
	}
	return parsed as QueryResponse;
}

function listFunctions(key: string, filter: string, repoRoot: string): void {
	// function-spec is metadata-only. With CONVEX_DEPLOY_KEY set it targets the
	// key's deployment and ignores selector flags, so the read key decides the target.
	const backendDir = existsSync(resolve(repoRoot, "packages/backend"))
		? resolve(repoRoot, "packages/backend")
		: process.cwd();
	const env = { ...process.env, [devKeyVar]: key };
	delete env.CONVEX_DEPLOYMENT;
	delete env.CONVEX_URL;
	// A real deployment's spec is several MB; stream it to a temp file instead of
	// a pipe buffer (Bun's spawnSync drops oversized piped stdout).
	const specFile = resolve(
		tmpdir(),
		`convex-prod-query-spec-${process.pid}-${Date.now()}.json`,
	);
	let stdout = "";
	let stderr = "";
	let status: number | null = null;
	try {
		const result = Bun.spawnSync(["bunx", "convex", "function-spec"], {
			cwd: backendDir,
			env,
			stderr: "pipe",
			stdin: "ignore",
			stdout: Bun.file(specFile),
		});
		status = result.exitCode;
		stderr = result.stderr.toString();
		stdout = existsSync(specFile) ? readFileSync(specFile, "utf8") : "";
	} catch (error) {
		// e.g. a sandbox that forbids the temp-file write or the spawn itself.
		fail(
			`could not run convex function-spec (cwd ${backendDir}, spec file ${specFile}): ${(error as Error).message}`,
			1,
		);
	} finally {
		if (existsSync(specFile)) {
			unlinkSync(specFile);
		}
	}
	if (status !== 0) {
		fail(`convex function-spec failed in ${backendDir}:\n${stderr}`, 1);
	}
	const start = stdout.indexOf("{");
	const end = stdout.lastIndexOf("}");
	if (start === -1 || end === -1) {
		fail(
			`could not find JSON in function-spec output (${stdout.length} bytes)`,
			1,
		);
	}
	const spec = JSON.parse(stdout.slice(start, end + 1)) as {
		functions: FunctionSpecEntry[];
	};
	const needle = filter.toLowerCase();
	const rows = spec.functions
		.filter(
			(entry) => entry.functionType === "Query" && entry.identifier !== undefined,
		)
		.map((entry) => ({
			path: (entry.identifier as string).replace(/\.js:/, ":"),
			visibility: entry.visibility?.kind ?? "?",
		}))
		.filter((row) => row.path.toLowerCase().includes(needle))
		.sort((a, b) => a.path.localeCompare(b.path));
	for (const row of rows) {
		process.stdout.write(`${row.visibility.padEnd(8)} ${row.path}\n`);
	}
	process.stderr.write(`${rows.length} queries\n`);
}

async function main(): Promise<void> {
	const parsed = parseArgs(process.argv.slice(2));
	const repoRoot = findRepoRoot(process.cwd());
	loadEnv(parsed.envFile ?? resolve(repoRoot, ".env"), parsed.envFile !== undefined);
	const credential = resolveCredential(parsed.dev);
	const target = resolveUrl(credential.key, parsed.url);

	if (parsed.list !== undefined) {
		process.stderr.write(`target ${target.label} via ${credential.label}\n`);
		listFunctions(credential.key, parsed.list, repoRoot);
		return;
	}

	const functionPath = parsed.functionPath as string;
	process.stderr.write(
		`query ${functionPath} on ${target.label} via ${credential.label}\n`,
	);
	const response = await runQuery(
		target.url,
		credential.key,
		functionPath,
		parsed.args,
	);

	if (response.status === "success") {
		process.stdout.write(`${JSON.stringify(response.value, null, 2)}\n`);
		return;
	}

	const message = response.errorMessage;
	if (/but it is defined as (Mutation|Action)/.test(message)) {
		fail(
			`${functionPath} is not a query, so this tool will not run it.\n` +
				`Server said: ${message.trim()}\n` +
				"Production writes go through `bunx convex run ... --prod` with a one-time `dcg allow-once`.",
			1,
		);
	}
	if (/Could not find public function/.test(message)) {
		fail(
			`${message.trim()}\nThe credential was not accepted as admin (or the path is wrong). ` +
				"Check the key, or run `convex-prod-query --list <substring>`.",
			1,
		);
	}
	fail(
		`${message.trim()}${response.errorData === undefined ? "" : `\nerrorData: ${JSON.stringify(response.errorData)}`}`,
		1,
	);
}

await main();
