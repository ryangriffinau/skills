#!/usr/bin/env bash
# Check that an agent session runs in a terminal CLI, and manage a local
# trigger job for Codex CLI or Gemini CLI at fixed Melbourne times.
set -euo pipefail

TRIGGER_TZ="Australia/Melbourne"
TRIGGER_HOURS="00|05|10|15|20"
TRIGGER_MINUTE=7
TRIGGER_PROMPT="Reply with OK. This is a scheduled usage trigger."
RUN_TIMEOUT_SECONDS=300
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-5-hour-trigger"
LABEL_PREFIX="local.agent-5-hour-trigger"

usage() {
  cat <<'USAGE'
usage: agent-5-hour-trigger <command> [options]

commands:
  check
      Report the agent host and surface. Exit 0 only for a terminal CLI.
  install --host codex|gemini --model MODEL [--dry-run]
      Install a local job that runs the host CLI at 12:07am, 5:07am,
      10:07am, 3:07pm and 8:07pm Melbourne time. Uses launchd on macOS
      and crontab on Linux. Claude Code uses /schedule instead.
  uninstall --host codex|gemini [--dry-run]
      Remove the local job and its runner. The log is kept.
  status
      Show installed jobs and recent log lines.
  classify PATH ARGS
      Print the agent and surface for one process path and argument string.

check exit codes: 0 terminal CLI, 3 known non-CLI surface, 4 unknown host.
AGENT_5_HOUR_TRIGGER_START_PID sets where the process ancestry walk starts.
USAGE
}

fail() {
  echo "agent-5-hour-trigger: error: $*" >&2
  exit 2
}

# ---------- process inspection ----------

proc_exe() {
  local pid="$1" exe=""
  if [ -L "/proc/$pid/exe" ]; then
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  fi
  if [ -z "$exe" ]; then
    exe="$(ps -o comm= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//' || true)"
  fi
  printf '%s\n' "$exe"
}

proc_args() {
  if [ -r "/proc/$1/cmdline" ]; then
    tr '\0' ' ' <"/proc/$1/cmdline" | sed 's/ $//'
    echo
  else
    ps -o args= -p "$1" 2>/dev/null | sed 's/^[[:space:]]*//' || true
  fi
}

proc_ppid() {
  if [ -r "/proc/$1/status" ]; then
    sed -n 's/^PPid:[[:space:]]*//p' "/proc/$1/status"
  else
    ps -o ppid= -p "$1" 2>/dev/null | tr -d '[:space:]' || true
  fi
}

proc_tty() {
  ps -o tty= -p "$1" 2>/dev/null | tr -d '[:space:]' || true
}

# Print claude, codex or gemini when a process is one of those agents.
agent_kind() {
  local exe="$1" args="$2" exe_base first first_base name
  exe_base="${exe##*/}"
  first="${args%% *}"
  first_base="${first##*/}"
  for name in codex claude gemini; do
    if [ "$exe_base" = "$name" ] || [ "$first_base" = "$name" ]; then
      echo "$name"
      return 0
    fi
  done
  case "$exe_base" in
    node|bun)
      case " $args " in
        *"/gemini "*|*"/gemini-cli/"*|*"@google/gemini-cli"*) echo gemini ;;
      esac
      ;;
  esac
}

# Print cli, desktop or ide for an agent process path and arguments.
classify_surface() {
  local exe="$1" args="$2"
  case "$exe $args" in
    *"/.vscode/extensions/"*|*"/.vscode-server/"*|*"/.cursor/extensions/"*|*"/.cursor-server/"*|*"/.windsurf/extensions/"*|*"/.antigravity/extensions/"*|*"/JetBrains/"*)
      echo ide
      return 0
      ;;
    *".app/Contents/"*)
      echo desktop
      return 0
      ;;
  esac
  case " $args " in
    *" app-server "*) echo desktop ;;
    *" --acp "*|*" --experimental-acp "*) echo ide ;;
    *) echo cli ;;
  esac
}

cmd_classify() {
  [ "$#" -eq 2 ] || fail "classify needs PATH and ARGS"
  local kind
  kind="$(agent_kind "$1" "$2")"
  echo "agent=${kind:-none}"
  if [ -n "$kind" ]; then
    echo "surface=$(classify_surface "$1" "$2")"
  fi
}

cmd_check() {
  local pid="${AGENT_5_HOUR_TRIGGER_START_PID:-$PPID}" depth=0
  local exe args kind=""
  local tree_host="" tree_surface="" agent_pid="" agent_exe="" agent_tty=""
  local host="unknown" surface="unknown"

  # The nearest agent process in this command's ancestry is the host.
  while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && [ "$depth" -lt 50 ]; do
    exe="$(proc_exe "$pid")"
    args="$(proc_args "$pid")"
    kind="$(agent_kind "$exe" "$args")"
    if [ -n "$kind" ]; then
      tree_host="$kind"
      tree_surface="$(classify_surface "$exe" "$args")"
      agent_pid="$pid"
      agent_exe="$exe"
      agent_tty="$(proc_tty "$pid")"
      break
    fi
    pid="$(proc_ppid "$pid")"
    depth=$((depth + 1))
  done

  if [ -n "$tree_host" ]; then
    host="$tree_host"
  elif [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
    host="claude"
  elif [ "${GEMINI_CLI:-}" = "1" ]; then
    host="gemini"
  fi

  case "$host" in
    claude)
      if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
        surface="web"
      else
        case "${CLAUDE_CODE_ENTRYPOINT:-}" in
          cli|sdk-cli) surface="cli" ;;
          claude-desktop) surface="desktop" ;;
          claude-vscode|*jetbrains*|*ide*) surface="ide" ;;
          "") surface="${tree_surface:-unknown}" ;;
          *) surface="other" ;;
        esac
      fi
      ;;
    codex)
      surface="${tree_surface:-unknown}"
      ;;
    gemini)
      # Gemini CLI sets GEMINI_CLI=1 for the commands its shell tool runs.
      surface="${tree_surface:-cli}"
      ;;
  esac

  # A non-CLI process path overrides an environment that claims a CLI.
  if [ "$host" = "$tree_host" ] && [ -n "$tree_surface" ] && [ "$tree_surface" != "cli" ]; then
    surface="$tree_surface"
  fi

  echo "host=$host"
  echo "surface=$surface"
  if [ "$host" = "claude" ]; then
    echo "claude_entrypoint=${CLAUDE_CODE_ENTRYPOINT:-}"
  fi
  if [ -n "$agent_pid" ]; then
    echo "agent_pid=$agent_pid"
    echo "agent_path=$agent_exe"
    echo "agent_tty=${agent_tty:-none}"
  fi

  if [ "$host" = "unknown" ]; then
    echo "agent-5-hour-trigger: no Claude Code, Codex or Gemini CLI session found" >&2
    return 4
  fi
  if [ "$surface" != "cli" ]; then
    echo "agent-5-hour-trigger: $host is running in the $surface surface, not a terminal CLI" >&2
    return 3
  fi
  return 0
}

# ---------- local schedule ----------

offset_minutes() {
  local z="$1" sign=1 h m
  case "$z" in -*) sign=-1 ;; esac
  z="${z#[+-]}"
  h="${z%??}"
  m="${z#??}"
  echo $((sign * (10#$h * 60 + 10#$m)))
}

# The local minute that matches minute 7 in Melbourne. DST shifts are whole
# hours, so this minute holds all year; the runner gates on the hour.
local_minute() {
  local here there
  here="$(offset_minutes "$(date +%z)")"
  there="$(offset_minutes "$(TZ="$TRIGGER_TZ" date +%z)")"
  echo $(((((TRIGGER_MINUTE + here - there) % 60) + 60) % 60))
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

render_runner() {
  local host="$1" bin="$2" model="$3" log="$4" cmd
  case "$host" in
    codex)
      cmd="$(printf '%q ' "$bin" exec --skip-git-repo-check --ephemeral --sandbox read-only -m "$model" "$TRIGGER_PROMPT")"
      ;;
    gemini)
      cmd="$(printf '%q ' "$bin" -m "$model" -p "$TRIGGER_PROMPT")"
      ;;
  esac
  cat <<RUNNER
#!/bin/bash
# Generated by agent-5-hour-trigger install for $host. Reinstall to change it.
set -u
export PATH=$(printf '%q' "$PATH")
case "\$(TZ=$TRIGGER_TZ date +%H)" in
  $TRIGGER_HOURS) ;;
  *) exit 0 ;;
esac
cd $(printf '%q' "$STATE_DIR") || exit 1
{
  printf '=== %s host=%s model=%s\n' "\$(date '+%Y-%m-%dT%H:%M:%S%z')" $host $(printf '%q' "$model")
  $cmd</dev/null &
  pid=\$!
  ( sleep $RUN_TIMEOUT_SECONDS && kill "\$pid" 2>/dev/null ) &
  watchdog=\$!
  wait "\$pid"
  status=\$?
  kill "\$watchdog" 2>/dev/null
  printf 'exit=%s\n' "\$status"
} >>$(printf '%q' "$log") 2>&1
RUNNER
}

render_plist() {
  local label="$1" runner="$2" minute="$3" log="$4"
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$(xml_escape "$runner")</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>$minute</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>$(xml_escape "$log")</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "$log")</string>
</dict>
</plist>
PLIST
}

cron_marker() {
  echo "# agent-5-hour-trigger:$1"
}

cron_line() {
  local minute="$1" runner="$2" host="$3"
  echo "$minute * * * * /bin/bash $(printf '%q' "$runner") $(cron_marker "$host")"
}

parse_host_args() {
  HOST=""
  MODEL=""
  DRY_RUN=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host)
        [ "$#" -ge 2 ] || fail "missing --host value"
        HOST="$2"
        shift 2
        ;;
      --model)
        [ "$#" -ge 2 ] || fail "missing --model value"
        MODEL="$2"
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      *) fail "unknown argument: $1" ;;
    esac
  done
  case "$HOST" in
    codex|gemini) ;;
    claude) fail "Claude Code schedules this with /schedule, not a local job" ;;
    *) fail "--host must be codex or gemini" ;;
  esac
}

cmd_install() {
  parse_host_args "$@"
  [ -n "$MODEL" ] || fail "--model is required; use the lightest model $HOST lists"
  local bin minute runner log label plist="" os
  bin="$(command -v "$HOST" || true)"
  case "$bin" in
    /*) ;;
    *) fail "$HOST CLI not found on PATH" ;;
  esac
  minute="$(local_minute)"
  runner="$STATE_DIR/run-$HOST.sh"
  log="$STATE_DIR/$HOST.log"
  label="$LABEL_PREFIX.$HOST"
  os="$(uname -s)"

  echo "host=$HOST"
  echo "model=$MODEL"
  echo "cli=$bin"
  echo "melbourne_times=00:07 05:07 10:07 15:07 20:07"
  echo "local_minute=$minute"
  echo "runner=$runner"
  echo "log=$log"

  case "$os" in
    Darwin)
      plist="$HOME/Library/LaunchAgents/$label.plist"
      echo "scheduler=launchd"
      echo "plist=$plist"
      ;;
    Linux)
      command -v crontab >/dev/null 2>&1 || fail "crontab not found; install cron first"
      echo "scheduler=crontab"
      ;;
    *) fail "unsupported OS: $os" ;;
  esac

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "--- runner"
    render_runner "$HOST" "$bin" "$MODEL" "$log"
    if [ "$os" = "Darwin" ]; then
      echo "--- plist"
      render_plist "$label" "$runner" "$minute" "$log"
    else
      echo "--- crontab line"
      cron_line "$minute" "$runner" "$HOST"
    fi
    echo "--- dry run: nothing written"
    return 0
  fi

  mkdir -p "$STATE_DIR"
  render_runner "$HOST" "$bin" "$MODEL" "$log" >"$runner.tmp"
  chmod 700 "$runner.tmp"
  mv "$runner.tmp" "$runner"

  if [ "$os" = "Darwin" ]; then
    mkdir -p "$HOME/Library/LaunchAgents"
    render_plist "$label" "$runner" "$minute" "$log" >"$plist"
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    launchctl print "gui/$(id -u)/$label" >/dev/null || fail "launchd did not load $label"
    echo "installed=launchd:$label"
  else
    local line
    line="$(cron_line "$minute" "$runner" "$HOST")"
    { crontab -l 2>/dev/null | grep -vF "$(cron_marker "$HOST")" || true; echo "$line"; } | crontab -
    crontab -l | grep -qF "$(cron_marker "$HOST")" || fail "crontab line not found after install"
    echo "installed=crontab"
  fi
}

cmd_uninstall() {
  parse_host_args "$@"
  local runner="$STATE_DIR/run-$HOST.sh" label="$LABEL_PREFIX.$HOST"
  local plist="$HOME/Library/LaunchAgents/$label.plist"
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "would remove the $HOST job and $runner"
    [ "$(uname -s)" = "Darwin" ] && echo "would remove $plist"
    return 0
  fi
  case "$(uname -s)" in
    Darwin)
      launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
      rm -f "$plist"
      ;;
    Linux)
      if crontab -l >/dev/null 2>&1; then
        { crontab -l | grep -vF "$(cron_marker "$HOST")" || true; } | crontab -
      fi
      ;;
  esac
  rm -f "$runner"
  echo "removed=$HOST"
}

cmd_status() {
  local host label plist log
  for host in codex gemini; do
    label="$LABEL_PREFIX.$host"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    log="$STATE_DIR/$host.log"
    echo "== $host"
    case "$(uname -s)" in
      Darwin)
        if launchctl print "gui/$(id -u)/$label" >/dev/null 2>&1; then
          echo "launchd=loaded"
        elif [ -f "$plist" ]; then
          echo "launchd=plist present, not loaded"
        else
          echo "launchd=not installed"
        fi
        ;;
      Linux)
        if crontab -l 2>/dev/null | grep -qF "$(cron_marker "$host")"; then
          echo "crontab=installed"
        else
          echo "crontab=not installed"
        fi
        ;;
    esac
    if [ -f "$log" ]; then
      echo "recent log:"
      tail -n 6 "$log"
    fi
  done
}

main() {
  local cmd="${1:-}"
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$cmd" in
    check) cmd_check "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    status) cmd_status "$@" ;;
    classify) cmd_classify "$@" ;;
    -h|--help|help) usage ;;
    "")
      usage >&2
      exit 2
      ;;
    *) fail "unknown command: $cmd" ;;
  esac
}

main "$@"
