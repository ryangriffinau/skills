#!/usr/bin/env bash
# Check that an agent session runs in a terminal CLI, print the cloud schedule
# for hosts whose CLI has a cloud scheduler, and manage the local fallback job
# for hosts whose CLI does not.
set -euo pipefail

TRIGGER_NAME="agent-5-hour-trigger"
TRIGGER_TZ="Australia/Melbourne"
TRIGGER_HOUR_LIST="0 5 10 15 20"
TRIGGER_MINUTE=7
TRIGGER_PROMPT="Quickly check in and reply with OK. Do nothing else."
RUN_TIMEOUT_SECONDS=300
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/agent-5-hour-trigger"
LABEL_PREFIX="local.agent-5-hour-trigger"
LOCAL_HOSTS="codex agy"

usage() {
  cat <<'USAGE'
usage: agent-5-hour-trigger <command> [options]

commands:
  check
      Report the agent host, surface and scheduler. Exit 0 only for a
      terminal CLI.
  plan --host claude|codex|agy
      Print the trigger settings: the cloud task for claude, the local job
      for codex and agy.
  install --host codex|agy [--dry-run] [--replace]
      Install the local job. It runs the host CLI at 12:07am, 5:07am,
      10:07am, 3:07pm and 8:07pm Melbourne time, using launchd on macOS and
      crontab on Linux. An installed job is left alone unless --replace.
  uninstall --host codex|agy [--dry-run]
      Remove the local job and its runner. The log is kept.
  status [--host codex|agy]
      Show the local job state and recent log lines.
  classify PATH ARGS
      Print the agent and surface for one process path and argument string.

check exit codes: 0 terminal CLI, 3 non-CLI surface, 4 no agent found,
5 a sandbox blocked the check (rerun it outside the sandbox).
AGENT_5_HOUR_TRIGGER_START_PID sets where the process ancestry walk starts.
USAGE
}

fail() {
  echo "agent-5-hour-trigger: error: $*" >&2
  exit 2
}

# ---------- hosts ----------
# To add a host: give it a scheduler in host_scheduler, teach agent_kind its
# process name, and give a local host a command in host_trigger_command.

host_scheduler() {
  case "$1" in
    claude) echo cloud ;;
    codex|agy) echo local ;;
    *) echo unknown ;;
  esac
}

host_trigger_command() {
  local host="$1" bin="$2"
  case "$host" in
    codex) printf '%q ' "$bin" exec --skip-git-repo-check --ephemeral --sandbox read-only "$TRIGGER_PROMPT" ;;
    agy) printf '%q ' "$bin" -p "$TRIGGER_PROMPT" ;;
    *) fail "no local trigger command for $host" ;;
  esac
}

# Print claude, codex or agy when a process is one of those agents.
agent_kind() {
  local exe_base="${1##*/}" first="${2%% *}" first_base name
  first_base="${first##*/}"
  for name in "$exe_base" "$first_base"; do
    case "$name" in
      claude|codex|agy)
        echo "$name"
        return 0
        ;;
    esac
  done
}

# Print cli, desktop or ide for an agent process path and arguments.
classify_surface() {
  local exe="$1" args="$2"
  case "$exe $args" in
    *"/.vscode/extensions/"*|*"/.vscode-server/"*|*"/.cursor/extensions/"*|*"/.cursor-server/"*|*"/.windsurf/extensions/"*|*"/.antigravity/extensions/"*|*"/JetBrains/"*)
      echo ide
      return 0
      ;;
    *".app/Contents/"*)
      echo desktop
      return 0
      ;;
  esac
  case " $args " in
    *" app-server "*) echo desktop ;;
    *" acp "*|*" --acp "*|*" --experimental-acp "*) echo ide ;;
    *) echo cli ;;
  esac
}

# ---------- process inspection ----------

can_inspect_processes() {
  [ -r /proc/self/status ] && return 0
  ps -o pid= -p "$$" >/dev/null 2>&1
}

proc_exe() {
  local pid="$1" exe=""
  if [ -L "/proc/$pid/exe" ]; then
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  fi
  if [ -z "$exe" ]; then
    exe="$(ps -o comm= -p "$pid" 2>/dev/null | sed 's/^[[:space:]]*//' || true)"
  fi
  printf '%s\n' "$exe"
}

proc_args() {
  if [ -r "/proc/$1/cmdline" ]; then
    tr '\0' ' ' <"/proc/$1/cmdline" | sed 's/ $//'
    echo
  else
    ps -o args= -p "$1" 2>/dev/null | sed 's/^[[:space:]]*//' || true
  fi
}

proc_ppid() {
  if [ -r "/proc/$1/status" ]; then
    sed -n 's/^PPid:[[:space:]]*//p' "/proc/$1/status"
  else
    ps -o ppid= -p "$1" 2>/dev/null | tr -d '[:space:]' || true
  fi
}

proc_tty() {
  ps -o tty= -p "$1" 2>/dev/null | tr -d '[:space:]' || true
}

cmd_classify() {
  [ "$#" -eq 2 ] || fail "classify needs PATH and ARGS"
  local kind
  kind="$(agent_kind "$1" "$2")"
  echo "agent=${kind:-none}"
  if [ -n "$kind" ]; then
    echo "surface=$(classify_surface "$1" "$2")"
  fi
}

cmd_check() {
  local pid="${AGENT_5_HOUR_TRIGGER_START_PID:-$PPID}" depth=0 inspection="ok"
  local exe args kind=""
  local tree_host="" tree_surface="" agent_pid="" agent_exe="" agent_tty=""
  local host="unknown" surface="unknown"

  # The nearest agent process in this command's ancestry is the host.
  if can_inspect_processes; then
    while [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null && [ "$depth" -lt 50 ]; do
      exe="$(proc_exe "$pid")"
      args="$(proc_args "$pid")"
      kind="$(agent_kind "$exe" "$args")"
      if [ -n "$kind" ]; then
        tree_host="$kind"
        tree_surface="$(classify_surface "$exe" "$args")"
        agent_pid="$pid"
        agent_exe="$exe"
        agent_tty="$(proc_tty "$pid")"
        break
      fi
      pid="$(proc_ppid "$pid")"
      depth=$((depth + 1))
    done
  else
    inspection="blocked"
  fi

  # Without a process match, use the markers each host sets for the commands
  # it runs. Codex sets CODEX_SANDBOX for sandboxed commands, where ps is
  # blocked. It is checked before Claude's markers, which leak into processes
  # started from a Claude session.
  if [ -n "$tree_host" ]; then
    host="$tree_host"
  elif [ -n "${CODEX_SANDBOX:-}" ]; then
    host="codex"
  elif [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
    host="claude"
  fi

  case "$host" in
    claude)
      if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
        surface="web"
      else
        case "${CLAUDE_CODE_ENTRYPOINT:-}" in
          cli|sdk-cli) surface="cli" ;;
          claude-desktop) surface="desktop" ;;
          claude-vscode|*jetbrains*|*ide*) surface="ide" ;;
          "") surface="${tree_surface:-unknown}" ;;
          *) surface="other" ;;
        esac
      fi
      ;;
    codex)
      surface="${tree_surface:-sandboxed}"
      ;;
    agy)
      surface="${tree_surface:-unknown}"
      ;;
  esac

  # A non-CLI process path overrides an environment that claims a CLI.
  if [ "$host" = "$tree_host" ] && [ -n "$tree_surface" ] && [ "$tree_surface" != "cli" ]; then
    surface="$tree_surface"
  fi

  echo "host=$host"
  echo "surface=$surface"
  echo "scheduler=$(host_scheduler "$host")"
  echo "process_inspection=$inspection"
  if [ "$host" = "claude" ]; then
    echo "claude_entrypoint=${CLAUDE_CODE_ENTRYPOINT:-}"
  fi
  if [ -n "$agent_pid" ]; then
    echo "agent_pid=$agent_pid"
    echo "agent_path=$agent_exe"
    echo "agent_tty=${agent_tty:-none}"
  fi

  if [ "$surface" = "sandboxed" ] || { [ "$host" = "unknown" ] && [ "$inspection" = "blocked" ]; }; then
    echo "agent-5-hour-trigger: a sandbox blocked the process check; rerun it outside the sandbox" >&2
    return 5
  fi
  if [ "$host" = "unknown" ]; then
    echo "agent-5-hour-trigger: no Claude Code, Codex or Antigravity CLI session found" >&2
    return 4
  fi
  if [ "$surface" != "cli" ]; then
    echo "agent-5-hour-trigger: $host is running in the $surface surface, not a terminal CLI" >&2
    return 3
  fi
  return 0
}

# ---------- schedule ----------

# Without zone data, TZ=Australia/Melbourne silently means UTC.
require_zone() {
  local dir
  for dir in "${TZDIR:-}" /usr/share/zoneinfo /usr/lib/zoneinfo /usr/share/lib/zoneinfo /var/db/timezone/zoneinfo; do
    if [ -n "$dir" ] && [ -f "$dir/$TRIGGER_TZ" ]; then
      return 0
    fi
  done
  fail "time zone data for $TRIGGER_TZ not found; install tzdata"
}

offset_minutes() {
  local z="$1" sign=1 h m
  case "$z" in -*) sign=-1 ;; esac
  z="${z#[+-]}"
  h="${z%??}"
  m="${z#??}"
  echo $((sign * (10#$h * 60 + 10#$m)))
}

hour_csv() {
  printf '%s' "$TRIGGER_HOUR_LIST" | tr -s ' ' ','
}

hour_gate_pattern() {
  local h out=""
  for h in $TRIGGER_HOUR_LIST; do
    out="$out|$(printf '%02d' "$h")"
  done
  echo "${out#|}"
}

# The same times as a UTC cron at the current Melbourne offset. It drifts by an
# hour when daylight saving changes, unlike the CRON_TZ form.
utc_cron() {
  local off h total minute=0 hours=""
  off="$(offset_minutes "$(TZ="$TRIGGER_TZ" date +%z)")"
  for h in $TRIGGER_HOUR_LIST; do
    total=$((((h * 60 + TRIGGER_MINUTE - off) % 1440 + 1440) % 1440))
    minute=$((total % 60))
    hours="$hours $((total / 60))"
  done
  hours="$(printf '%s\n' "$hours" | tr -s ' ' '\n' | sed '/^$/d' | sort -n | paste -sd, -)"
  echo "$minute $hours * * *"
}

# The local minute that matches minute 7 in Melbourne. DST shifts are whole
# hours, so this minute holds all year; the runner gates on the hour.
local_minute() {
  local here there
  here="$(offset_minutes "$(date +%z)")"
  there="$(offset_minutes "$(TZ="$TRIGGER_TZ" date +%z)")"
  echo $(((((TRIGGER_MINUTE + here - there) % 60) + 60) % 60))
}

runner_path() {
  echo "$STATE_DIR/run-$1.sh"
}

log_path() {
  echo "$STATE_DIR/$1.log"
}

plist_path() {
  echo "$HOME/Library/LaunchAgents/$LABEL_PREFIX.$1.plist"
}

cron_marker() {
  echo "# agent-5-hour-trigger:$1"
}

cron_line() {
  local minute="$1" runner="$2" host="$3"
  echo "$minute * * * * /bin/bash $(printf '%q' "$runner") $(cron_marker "$host")"
}

current_crontab() {
  crontab -l 2>/dev/null || true
}

xml_escape() {
  printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# installed, broken (files without a loaded job) or not-installed.
job_state() {
  local host="$1" table
  case "$(uname -s)" in
    Darwin)
      if launchctl print "gui/$(id -u)/$LABEL_PREFIX.$host" >/dev/null 2>&1; then
        echo installed
      elif [ -f "$(plist_path "$host")" ] || [ -f "$(runner_path "$host")" ]; then
        echo broken
      else
        echo not-installed
      fi
      ;;
    Linux)
      table="$(current_crontab)"
      if grep -qF "$(cron_marker "$host")" <<<"$table"; then
        echo installed
      elif [ -f "$(runner_path "$host")" ]; then
        echo broken
      else
        echo not-installed
      fi
      ;;
    *) echo not-installed ;;
  esac
}

render_runner() {
  local host="$1" bin="$2" log="$3" cmd
  cmd="$(host_trigger_command "$host" "$bin")"
  cat <<RUNNER
#!/bin/bash
# Generated by agent-5-hour-trigger install for $host. Reinstall to change it.
set -u
export PATH=$(printf '%q' "$PATH")
case "\$(TZ=$TRIGGER_TZ date +%H)" in
  $(hour_gate_pattern)) ;;
  *) exit 0 ;;
esac
cd $(printf '%q' "$STATE_DIR") || exit 1
{
  printf '=== %s host=%s\n' "\$(date '+%Y-%m-%dT%H:%M:%S%z')" $host
  $cmd</dev/null &
  pid=\$!
  ( sleep $RUN_TIMEOUT_SECONDS && kill "\$pid" 2>/dev/null ) &
  watchdog=\$!
  wait "\$pid"
  status=\$?
  kill "\$watchdog" 2>/dev/null
  printf 'exit=%s\n' "\$status"
} >>$(printf '%q' "$log") 2>&1
RUNNER
}

render_plist() {
  local label="$1" runner="$2" minute="$3" log="$4"
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(xml_escape "$label")</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$(xml_escape "$runner")</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>$minute</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>$(xml_escape "$log")</string>
  <key>StandardErrorPath</key>
  <string>$(xml_escape "$log")</string>
</dict>
</plist>
PLIST
}

# Sets HOST, DRY_RUN and REPLACE. ALLOWED lists the hosts this command takes.
parse_args() {
  local allowed="$1"
  shift
  HOST=""
  DRY_RUN=0
  REPLACE=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --host)
        [ "$#" -ge 2 ] || fail "missing --host value"
        HOST="$2"
        shift 2
        ;;
      --dry-run)
        DRY_RUN=1
        shift
        ;;
      --replace)
        REPLACE=1
        shift
        ;;
      *) fail "unknown argument: $1" ;;
    esac
  done
  case " $allowed " in
    *" $HOST "*) ;;
    *)
      if [ "$HOST" = "claude" ]; then
        fail "Claude Code schedules this in the cloud with /schedule; see: plan --host claude"
      fi
      fail "--host must be one of: $allowed"
      ;;
  esac
}

cmd_plan() {
  parse_args "claude $LOCAL_HOSTS" "$@"
  require_zone
  local scheduler
  scheduler="$(host_scheduler "$HOST")"
  echo "host=$HOST"
  echo "scheduler=$scheduler"
  echo "name=$TRIGGER_NAME"
  echo "melbourne_times=00:07 05:07 10:07 15:07 20:07"
  echo "prompt=$TRIGGER_PROMPT"
  if [ "$scheduler" = "cloud" ]; then
    echo "cron=CRON_TZ=$TRIGGER_TZ $TRIGGER_MINUTE $(hour_csv) * * *"
    echo "cron_utc=$(utc_cron)"
    echo "repository=none"
    echo "connectors=none"
  else
    echo "local_minute=$(local_minute)"
    echo "next=install --host $HOST --dry-run"
  fi
}

cmd_install() {
  parse_args "$LOCAL_HOSTS" "$@"
  require_zone
  local bin state minute runner log label plist="" os
  bin="$(command -v "$HOST" || true)"
  case "$bin" in
    /*) ;;
    *) fail "$HOST CLI not found on PATH" ;;
  esac
  os="$(uname -s)"
  case "$os" in
    Darwin) plist="$(plist_path "$HOST")" ;;
    Linux) command -v crontab >/dev/null 2>&1 || fail "crontab not found; install cron first" ;;
    *) fail "unsupported OS: $os" ;;
  esac
  state="$(job_state "$HOST")"
  minute="$(local_minute)"
  runner="$(runner_path "$HOST")"
  log="$(log_path "$HOST")"
  label="$LABEL_PREFIX.$HOST"

  echo "host=$HOST"
  echo "scheduler=local"
  echo "cli=$bin"
  echo "prompt=$TRIGGER_PROMPT"
  echo "melbourne_times=00:07 05:07 10:07 15:07 20:07"
  echo "local_minute=$minute"
  echo "runner=$runner"
  echo "log=$log"
  if [ "$os" = "Darwin" ]; then
    echo "launchd_plist=$plist"
  else
    echo "crontab_marker=$(cron_marker "$HOST")"
  fi
  echo "existing_state=$state"

  if [ "$state" = "installed" ] && [ "$REPLACE" -eq 0 ]; then
    echo "status=already-installed"
    echo "agent-5-hour-trigger: the $HOST trigger is already installed; use --replace to reinstall it" >&2
    return 0
  fi

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "--- runner"
    render_runner "$HOST" "$bin" "$log"
    if [ "$os" = "Darwin" ]; then
      echo "--- plist"
      render_plist "$label" "$runner" "$minute" "$log"
    else
      echo "--- crontab line"
      cron_line "$minute" "$runner" "$HOST"
    fi
    echo "--- dry run: nothing written"
    return 0
  fi

  mkdir -p "$STATE_DIR"
  render_runner "$HOST" "$bin" "$log" >"$runner.tmp"
  chmod 700 "$runner.tmp"
  mv "$runner.tmp" "$runner"

  if [ "$os" = "Darwin" ]; then
    mkdir -p "$HOME/Library/LaunchAgents"
    render_plist "$label" "$runner" "$minute" "$log" >"$plist"
    launchctl bootout "gui/$(id -u)/$label" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
  else
    local table
    table="$(current_crontab)"
    {
      grep -vF "$(cron_marker "$HOST")" <<<"$table" || true
      cron_line "$minute" "$runner" "$HOST"
    } | sed '/^$/d' | crontab -
  fi
  [ "$(job_state "$HOST")" = "installed" ] || fail "the $HOST job did not load"
  echo "status=installed"
}

cmd_uninstall() {
  parse_args "$LOCAL_HOSTS" "$@"
  local state runner plist
  state="$(job_state "$HOST")"
  runner="$(runner_path "$HOST")"
  plist="$(plist_path "$HOST")"
  echo "host=$HOST"
  echo "existing_state=$state"
  if [ "$state" = "not-installed" ]; then
    echo "status=not-installed"
    return 0
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "would remove the $HOST job and $runner"
    if [ "$(uname -s)" = "Darwin" ]; then
      echo "would remove $plist"
    fi
    return 0
  fi
  case "$(uname -s)" in
    Darwin)
      launchctl bootout "gui/$(id -u)/$LABEL_PREFIX.$HOST" >/dev/null 2>&1 || true
      rm -f "$plist"
      ;;
    Linux)
      local table
      table="$(current_crontab)"
      if [ -n "$table" ]; then
        { grep -vF "$(cron_marker "$HOST")" <<<"$table" || true; } | crontab -
      fi
      ;;
  esac
  rm -f "$runner"
  [ "$(job_state "$HOST")" = "not-installed" ] || fail "the $HOST job is still present"
  echo "status=removed"
}

cmd_status() {
  local hosts host log
  if [ "$#" -gt 0 ]; then
    parse_args "claude $LOCAL_HOSTS" "$@"
    hosts="$HOST"
  else
    hosts="$LOCAL_HOSTS"
  fi
  for host in $hosts; do
    echo "host=$host"
    echo "scheduler=$(host_scheduler "$host")"
    if [ "$host" = "claude" ]; then
      echo "state=cloud"
      echo "note=list cloud tasks with /schedule list"
      continue
    fi
    echo "state=$(job_state "$host")"
    log="$(log_path "$host")"
    if [ -f "$log" ]; then
      echo "recent_log:"
      tail -n 6 "$log"
    fi
  done
}

main() {
  local cmd="${1:-}"
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$cmd" in
    check) cmd_check "$@" ;;
    plan) cmd_plan "$@" ;;
    install) cmd_install "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    status) cmd_status "$@" ;;
    classify) cmd_classify "$@" ;;
    -h|--help|help) usage ;;
    "")
      usage >&2
      exit 2
      ;;
    *) fail "unknown command: $cmd" ;;
  esac
}

main "$@"
